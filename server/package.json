{
  "name": "@kagayoi/memory-server",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm build && pnpm test",
    "deploy": "wrangler deploy --minify",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --experimental-transform-types --test tests/auth.test.mjs tests/topics.test.mjs tests/races.test.mjs && node tests/smoke.mjs",
    "test:live": "node tests/live-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "typescript": "^7.0.2",
    "wrangler": "4.131.1"
  }
}
